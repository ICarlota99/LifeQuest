{
  "name": "lifequest",
  "private": true,
  "version": "0.1.0",
  "description": "LifeQuest — D&D-inspired gamified personal development platform",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @lifequest/api --filter @lifequest/web dev",
    "dev:api": "pnpm --filter @lifequest/api dev",
    "dev:web": "pnpm --filter @lifequest/web dev",
    "build": "pnpm -r --filter @lifequest/domain --filter @lifequest/db --filter @lifequest/api --filter @lifequest/web build",
    "test": "pnpm -r --filter @lifequest/domain --filter @lifequest/db --filter @lifequest/api test",
    "db:generate": "pnpm --filter @lifequest/db generate",
    "db:migrate": "pnpm --filter @lifequest/db migrate",
    "db:push": "pnpm --filter @lifequest/db push",
    "db:studio": "pnpm --filter @lifequest/db studio",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0"
}
